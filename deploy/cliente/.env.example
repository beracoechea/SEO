# Copia este archivo a .env (no se sube a Git).
# ORG_ID: en la web, entra a la org → la URL es /o/ESTE_ID
ORG_ID=pega-aqui-el-id-de-la-org
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIRESTORE_DATABASE=webs
# Origen HTTPS de la cáscara (Firebase Hosting). En desarrollo local:
CORS_ORIGIN=https://bgx-seo-monitor.web.app,https://bgx-seo-monitor.firebaseapp.com
RUNTIME_PORT=8080
RUNTIME_VERSION=0.1.0
